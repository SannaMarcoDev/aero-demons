# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
# Git LFS for Terrain & Large Datasets
wc_data/**/*.res filter=lfs diff=lfs merge=lfs -text
terrain/**/*.res filter=lfs diff=lfs merge=lfs -text
# Baked Garda land cover and forest meshes
resources/terrain/garda_landcover.res filter=lfs diff=lfs merge=lfs -text
assets/environment/garda_forest/garda_fir_*.res filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.r16 filter=lfs diff=lfs merge=lfs -text
# Large music assets
assets/audio/music/*.wav filter=lfs diff=lfs merge=lfs -text
terrain/**/baked_*.tres filter=lfs diff=lfs merge=lfs -text
# Blender source files
*.blend filter=lfs diff=lfs merge=lfs -text
# Large authored airport/city exports
assets/environment/airport/*.glb filter=lfs diff=lfs merge=lfs -text
assets/environment/airport/library/*.glb filter=lfs diff=lfs merge=lfs -text
assets/environment/small_hangar/*.glb filter=lfs diff=lfs merge=lfs -text


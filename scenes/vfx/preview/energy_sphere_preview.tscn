[sub_resource type="Shader" id="Grid_shader"]
code = "shader_type spatial;
void fragment() {
 vec2 grid = UV * 100.0;
 vec2 line = abs(fract(grid - 0.5) - 0.5) / max(fwidth(grid), vec2(0.0001));
 float ink = 1.0 - min(min(line.x, line.y), 1.0);
 ALBEDO = mix(vec3(0.035, 0.047, 0.06), vec3(0.13, 0.17, 0.21), ink * 0.5);
 ROUGHNESS = 0.95;
}"


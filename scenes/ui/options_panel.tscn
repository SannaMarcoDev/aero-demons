[node name="OptionsPanel" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 0
script = ExtResource("1_script")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Sections" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="AudioBox" type="VBoxContainer" parent="Scroll/Sections"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AudioHeader" type="Label" parent="Scroll/Sections/AudioBox"]

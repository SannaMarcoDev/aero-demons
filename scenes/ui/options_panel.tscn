theme_override_colors/font_color = Color(0.35, 0.75, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 11
text = "// AUDIO BUS MIXER"

[node name="MasterRow" type="HBoxContainer" parent="Scroll/Sections/AudioBox"]

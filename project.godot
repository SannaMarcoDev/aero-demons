[internationalization]

locale/translations_pot_files=PackedStringArray("res://resources/dialogues/tutorial.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Native FXAA avoids temporal jitter on the lake; retain the original ripple shader.
anti_aliasing/quality/screen_space_aa=1
